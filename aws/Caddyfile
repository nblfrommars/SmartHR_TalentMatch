# Caddy tự xin và gia hạn chứng chỉ Let's Encrypt cho các domain dưới đây.
auth.{$DOMAIN} {
	reverse_proxy keycloak:8080
}

# Presigned URL của MinIO (MINIO_PUBLIC_ENDPOINT=https://files.<domain>)
files.{$DOMAIN} {
	reverse_proxy minio:9000
}

# Frontend + API + WebSocket cùng origin
{$DOMAIN} {
	handle /api/* {
		reverse_proxy api-gateway:8080
	}
	handle /ws/* {
		reverse_proxy api-gateway:8080
	}
	handle {
		reverse_proxy frontend:80
	}
}