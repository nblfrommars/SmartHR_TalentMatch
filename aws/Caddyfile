# Caddy tự xin và gia hạn chứng chỉ Let's Encrypt cho các domain dưới đây.
auth.{$DOMAIN} {
	reverse_proxy keycloak:8080
}

# Presigned URL của MinIO (MINIO_PUBLIC_ENDPOINT=https://files.<domain>)
files.{$DOMAIN} {
	reverse_proxy minio:9000
}

# API + WebSocket đi qua gateway (cùng origin với frontend)
{$DOMAIN} {
        handle /api/* {
                reverse_proxy api-gateway:8080
        }
        handle /ws/* {
                reverse_proxy api-gateway:8080
        }
        handle {
                reverse_proxy frontend:80
        }
}

	# Giai đoạn 3: thay khối handle cuối bằng
	# handle {
	# 	root * /srv/frontend
	# 	try_files {path} /index.html
	# 	file_server
	# }
	# và bỏ comment dòng mount ./frontend/dist trong docker-compose.aws.yml
}
