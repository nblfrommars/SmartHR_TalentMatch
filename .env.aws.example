# Copy thành .env.aws trên server, KHÔNG commit. Sinh secret: openssl rand -base64 24 | tr -d '/+='
DOMAIN=example.com

POSTGRES_USER=postgres
POSTGRES_PASSWORD=

MINIO_ROOT_USER=smarthr_minio
MINIO_ROOT_PASSWORD=

RABBITMQ_DEFAULT_USER=smarthr
RABBITMQ_DEFAULT_PASS=

KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=

# --- Giai đoạn 2 ---
# Registry ECR của tài khoản AWS (region Sydney)
ECR_REGISTRY=504552746970.dkr.ecr.ap-southeast-2.amazonaws.com
IMAGE_TAG=latest
# Secret client smarthr-admin-service trong Keycloak (Clients > smarthr-admin-service > Credentials)
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Tùy chọn (mặc định dùng hashing, không cần key)
# AI_EMBEDDING_PROVIDER=hashing
# AI_EMBEDDING_VERSION=hashing@v1
# OPENAI_API_KEY=
