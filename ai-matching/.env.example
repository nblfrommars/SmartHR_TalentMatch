AI_ENVIRONMENT=dev
AI_LOG_LEVEL=INFO

# Dense embedding: openai (chạy thật, cần key) | hashing (dev, không cần key)
AI_EMBEDDING_PROVIDER=hashing
AI_OPENAI_API_KEY=
AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536
# Đổi khi đổi model hoặc cách dựng document (ví dụ hashing@v1 khi dùng hashing)
AI_EMBEDDING_VERSION=text-embedding-3-small@v1
# Cache embedding: redis | memory | none
AI_EMBEDDING_CACHE=memory
AI_DOCUMENT_MAX_CHARS=6000

# Qdrant: URL server hoặc :memory: (chạy trong RAM)
AI_QDRANT_URL=http://localhost:6333
AI_QDRANT_API_KEY=
AI_REDIS_URL=redis://localhost:6379/0
# Kafka consumer (job.events, cv.profile.events). Trong docker-compose: kafka:9092;
# từ máy dev ngoài Docker: localhost:9095 (KAFKA_EXTERNAL_PORT)
AI_KAFKA_ENABLED=false
AI_KAFKA_BOOTSTRAP_SERVERS=localhost:9095
AI_KAFKA_GROUP_ID=ai-matching
AI_KAFKA_JOB_TOPIC=job.events
AI_KAFKA_CV_TOPIC=cv.profile.events
AI_KAFKA_MAX_ATTEMPTS=3

# CV từ user-cv chưa có cờ "cho phép HR tìm kiếm": giá trị dùng cho mọi CV (mặc định false)
AI_CV_SEARCHABLE_DEFAULT=false

# Phân quyền: true = bắt buộc có header X-User-Id (mọi request đi qua api-gateway)
AI_REQUIRE_IDENTITY=false
# Cache kết quả gợi ý trong Redis (cần AI_EMBEDDING_CACHE=redis), 0 = tắt
AI_REC_CACHE_TTL_SECONDS=600
# Giải thích bằng LLM (cần OpenAI key), mặc định tắt
AI_LLM_EXPLANATIONS=false
AI_LLM_EXPLAIN_TOP_K=5
AI_LLM_EXPLAIN_TIMEOUT_SECONDS=3
